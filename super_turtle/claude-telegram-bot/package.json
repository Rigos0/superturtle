{
  "name": "claude-telegram-bot-ts",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "./live.sh",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "check:bun-version": "bun run scripts/check-bun-version.ts",
    "test:stable": "bun run scripts/test-stable.ts",
    "verify:ci": "bun run check:bun-version && bun install --frozen-lockfile && bun run typecheck && bun run test:stable"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.144.1",
    "grammy": "^1.44.0",
    "openai": "^6.46.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  }
}
